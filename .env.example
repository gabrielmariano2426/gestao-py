# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore).

# Produção: string de conexão Postgres. Sem isso, a aplicação usa um
# SQLite local (gestao.db) — apenas para desenvolvimento.
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/gestao

# Chave usada para assinar sessões e sufixos de link de documento.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Integrações externas (opcionais nesta fase — necessárias a partir da
# Fase 2+ do ROADMAP.md, quando e-mail/IA/consulta CPF forem portados).
RESEND_API_KEY=
ANTHROPIC_API_KEY=
CPFCNPJ_TOKEN=

APP_NAME=Master Parceria — Gestão
